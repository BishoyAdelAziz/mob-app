{
  "expo": {
    "name": "mob-app",
    "slug": "mob-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assests/fonts/Montserrat-Black.ttf",
            "./assests/fonts/Montserrat-BlackItalic.ttf",
            "./assests/fonts/Montserrat-Bold.ttf",
            "./assests/fonts/Montserrat-BoldItalic.ttf",
            "./assests/fonts/Montserrat-ExtraBold.ttf",
            "./assests/fonts/Montserrat-ExtraBoldItalic.ttf",
            "./assests/fonts/Montserrat-ExtraLight.ttf",
            "./assests/fonts/Montserrat-ExtraLightItalic.ttf",
            "./assests/fonts/Montserrat-Light.ttf",
            "./assests/fonts/Montserrat-LightItalic.ttf",
            "./assests/fonts/Montserrat-Medium.ttf",
            "./assests/fonts/Montserrat-MediumItalic.ttf",
            "./assests/fonts/Montserrat-Regular.ttf",
            "./assests/fonts/Montserrat-RegularItalic.ttf",
            "./assests/fonts/Montserrat-SemiBold.ttf",
            "./assests/fonts/Montserrat-SemiBoldItalic.ttf",
            "./assests/fonts/Montserrat-Thin.ttf",
            "./assests/fonts/Montserrat-ThinItalic.ttf"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
